# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Database Configuration
# Local SQLite default: sqlite:///personal_finance.db
# PostgreSQL example: postgresql://username:password@localhost:5432/finance_db
DATABASE_URL=sqlite:///personal_finance.db

# Google Gemini API
# Get your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Application Settings
PORT=5000
DEBUG=True
